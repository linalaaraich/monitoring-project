#jinja2: lstrip_blocks: True, trim_blocks: True
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: "0.0.0.0:{{ otel_collector_grpc_port }}"
      http:
        endpoint: "0.0.0.0:{{ otel_collector_http_port }}"
{% if 'network' in group_names %}
  filelog/containers:
    include: [/var/lib/docker/containers/**/*-json.log]
    start_at: end
    include_file_path: true
    operators:
      - type: json_parser
        parse_from: body
        parse_to: attributes
      - type: move
        from: attributes.log
        to: body
      - type: move
        from: attributes.stream
        to: attributes["log.iostream"]
      - type: move
        from: attributes.time
        to: attributes["log.time"]
      - type: filter
        expr: 'body matches "otelcol\\\\.component" or body matches "fileconsumer" or body matches "node_exporter" or body matches "cadvisor"'
      - type: add
        field: resource["service.name"]
        value: kong-gateway
      - type: add
        field: resource["host.name"]
        value: {{ inventory_hostname }}
{% endif %}
{% if 'monitoring' in group_names %}
  # Self-monitoring: capture each docker container's stdout/stderr on the
  # monitoring VM and ship to Loki. Without this, the central observability
  # stack (loki, prometheus, grafana, jaeger, otel-collector itself,
  # node-exporter, cadvisor) is invisible to itself - "the cobbler's children
  # have no shoes". Added 2026-06-03 to fix Phase 1 audit gap #2.
  #
  # The compose file mounts /var/lib/docker/containers read-only into this
  # collector via the monitoring-compose.yml.j2 template.
  filelog/containers:
    include: [/var/lib/docker/containers/*/*-json.log]
    start_at: end
    include_file_path: true
    operators:
      # Each line is a docker json-log record: {"log":"...","stream":"stdout","time":"..."}
      - type: json_parser
        parse_from: body
        parse_to: attributes
      - type: move
        from: attributes.log
        to: body
      - type: move
        from: attributes.stream
        to: attributes["log.iostream"]
      - type: move
        from: attributes.time
        to: attributes["log.time"]
      # Extract the docker container id from the file path:
      #   /var/lib/docker/containers/<container_id>/<container_id>-json.log
      # Set as a resource attr so it can be promoted to a Loki label.
      - type: regex_parser
        parse_from: attributes["log.file.path"]
        regex: '^/var/lib/docker/containers/(?P<container_id>[a-f0-9]+)/'
        parse_to: resource
      # Drop the collector's own logs to avoid a feedback loop.
      - type: filter
        expr: 'body matches "otelcol\\\\.component" or body matches "fileconsumer"'
      - type: add
        field: resource["service.name"]
        value: monitoring-vm
      - type: add
        field: resource["host.name"]
        value: {{ inventory_hostname }}

  # Self-monitoring: host syslog + auth.log. Mounted read-only into the
  # collector via the monitoring-compose.yml.j2 template.
  filelog/syslog:
    include:
      - /var/log/host/syslog
      - /var/log/host/auth.log
    start_at: end
    include_file_path: true
    operators:
      - type: regex_parser
        parse_from: attributes["log.file.path"]
        regex: '^/var/log/host/(?P<log_source>[^/]+)$'
        parse_to: resource
      - type: add
        field: resource["service.name"]
        value: host-syslog
      - type: add
        field: resource["host.name"]
        value: {{ inventory_hostname }}
{% endif %}

processors:
  batch:
    send_batch_size: 200
    send_batch_max_size: 200
    timeout: 5s

  resource:
    attributes:
      - action: insert
        key: deployment.environment
        value: "cires"
      - action: insert
        key: loki.resource.labels
        value: service.name, host.name, deployment.environment, container_id, log_source
      - action: insert
        key: loki.format
        value: json

exporters:
  otlp/jaeger:
    endpoint: "{% if 'monitoring' in group_names %}jaeger:{{ jaeger_otlp_grpc_port }}{% else %}{{ prometheus_host }}:{{ jaeger_host_otlp_grpc_port }}{% endif %}"
    tls:
      insecure: true

  loki:
    endpoint: "http://{% if 'monitoring' in group_names %}loki:{{ loki_port }}{% else %}{{ prometheus_host }}:{{ loki_port }}{% endif %}/loki/api/v1/push"

  debug:
    verbosity: basic

extensions:
  health_check:
    endpoint: "0.0.0.0:{{ otel_collector_health_port }}"
  zpages:
    endpoint: "0.0.0.0:55679"

service:
  extensions: [health_check, zpages]
  telemetry:
    logs:
      level: warn
    metrics:
      address: "0.0.0.0:{{ otel_collector_metrics_port }}"
  pipelines:
    traces:
      receivers: [otlp]
      processors: [resource, batch]
      exporters: [otlp/jaeger]

    logs:
      receivers: [otlp{% if 'network' in group_names %}, filelog/containers{% endif %}{% if 'monitoring' in group_names %}, filelog/containers, filelog/syslog{% endif %}]
      processors: [resource, batch]
      exporters: [loki]
