# =============================================================================
# OTel Collector config for the dedicated GPU EC2 box (Phase 2, 2026-06-03;
# G2/G5 unified-view fixes 2026-06-04).
# MANAGED BY ANSIBLE (roles/triage_stack) — templated to
# {{ triage_stack_dir }}/otel-config.yaml. DO NOT EDIT BY HAND.
#
# Ships, to the central monitoring VM:
#   - per-container stdout/stderr for the triage + 6 ai-* containers, each
#     labelled with its REAL container name (G2 — was all `gpu-stack`)
#   - the Ollama HOST systemd unit's journal (G5 — was never shipped; Ollama
#     is a host unit, not a container, so filelog never saw it)
# all to the central Loki via Loki's native OTLP ingest (/otlp).
#
# Network: bridge; Tailscale MagicDNS resolves via the host resolver inherited
# from /etc/resolv.conf, same as the MCP containers.
# =============================================================================

receivers:
  # --- Container stdout/stderr, enriched with the REAL container name (G2) ---
  # The `container` operator (contrib) natively parses Docker json-log format
  # AND, with add_metadata_from_filepath + the mounted docker.sock, resolves
  # the container id in the file path to its container.name / image. That gives
  # us a per-service stream instead of one undifferentiated `gpu-stack`.
  filelog/containers:
    include:
      - /var/lib/docker/containers/*/*-json.log
    start_at: end
    include_file_path: true
    operators:
      - type: container
        format: docker
        add_metadata_from_filepath: true

  # --- Ollama host unit logs (G5) ---
  # Ollama is a HOST systemd unit, so its logs go to journald — which this image
  # can't read (no journalctl; the journald receiver crash-looped). Instead a
  # systemd drop-in mirrors the unit's stdout/stderr to a plain file (see the
  # role's ollama drop-in task) and we tail that as service_name=ollama.
  filelog/ollama:
    include:
      - /var/log/ollama/ollama.log
    start_at: end

processors:
  # Common attributes for everything off this host.
  resource/common:
    attributes:
      - action: insert
        key: host.name
        value: {{ triage_otel_host_name }}
      - action: insert
        key: deployment.environment
        value: cires

  # G2: map each container's log-file path (which carries the full container ID
  # — the docker json-log path is /var/lib/docker/containers/<ID>/<ID>-json.log)
  # to its real name, so each ai-* container gets its own Loki stream
  # (service_name=ai-triage-service / ai-mcp-prometheus / ...). The id→name map
  # is gathered live at apply time (see the docker-ps task) and templated here;
  # `log.file.path` is a resource attribute (it surfaces as the log_file_path
  # Loki label). Falls back to gpu-stack if no id matches.
  transform/container_name:
    log_statements:
      - context: resource
        statements:
{% for _line in (triage_docker_ps.stdout_lines | default([])) %}
{% set _p = _line.split() %}
{% if _p | length >= 2 %}
          - set(attributes["service.name"], "{{ _p[1] }}") where attributes["log.file.path"] != nil and IsMatch(attributes["log.file.path"], "{{ _p[0] }}")
{% endif %}
{% endfor %}
          - set(attributes["service.name"], "gpu-stack") where attributes["service.name"] == nil

  # G2 prerequisite: filelog emits log.file.path as a LOG-record attribute, so a
  # resource-context match on it never fires. Regroup logs by log.file.path so it
  # becomes a per-file RESOURCE attribute — then transform/container_name (resource
  # context) can match it and set a per-file service.name that Loki uses as the
  # stream label.
  groupbyattrs/file:
    keys:
      - log.file.path

  # G5: tag the Ollama log-file stream.
  resource/ollama:
    attributes:
      - action: upsert
        key: service.name
        value: ollama

  batch:
    send_batch_size: 200
    send_batch_max_size: 200
    timeout: 5s

exporters:
  otlphttp/loki:
    endpoint: "http://{{ triage_monitoring_host }}:{{ loki_port | default(3100) }}/otlp"
    tls:
      insecure: true

extensions:
  health_check:
    endpoint: "0.0.0.0:13133"

service:
  extensions: [health_check]
  telemetry:
    logs:
      level: warn
  pipelines:
    # Container logs -> per-service stream (G2).
    logs/containers:
      receivers: [filelog/containers]
      processors: [resource/common, groupbyattrs/file, transform/container_name, batch]
      exporters: [otlphttp/loki]
    # Ollama host-unit log file -> service_name=ollama (G5).
    logs/ollama:
      receivers: [filelog/ollama]
      processors: [resource/common, resource/ollama, batch]
      exporters: [otlphttp/loki]
