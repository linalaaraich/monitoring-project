# =============================================================================
# OTel Collector config for the dedicated GPU EC2 box (Phase 2, 2026-06-03;
# G2/G5 unified-view fixes 2026-06-04).
# MANAGED BY ANSIBLE (roles/triage_stack) — templated to
# {{ triage_stack_dir }}/otel-config.yaml. DO NOT EDIT BY HAND.
#
# Ships, to the central monitoring VM:
#   - per-container stdout/stderr for the triage + 6 ai-* containers (G2)
#   - the Ollama HOST systemd unit's journal (G5 — was never shipped; Ollama
#     is a host unit, not a container, so filelog never saw it)
# all to the central Loki via Loki's native OTLP ingest (/otlp).
#
# G2 HONESTY CAVEAT (2026-06-04 PM audit): the per-id service.name mapping below
# is PARTIAL and FRAGILE. It pins service.name from the live container-id→name
# map gathered at apply time, so a container RECREATE (new id) silently falls
# back to `gpu-stack` until the next ansible run. This is a known stopgap, NOT a
# closed item — the correct fix is Docker service-discovery (Alloy/Promtail or
# the receiver_creator), folded into Sprint 5 (EPIC13/observability). G5 (the
# Ollama host-unit log file) IS stable and complete.
#
# Network: bridge; Tailscale MagicDNS resolves via the host resolver inherited
# from /etc/resolv.conf, same as the MCP containers.
# =============================================================================

receivers:
  # --- Container stdout/stderr → per-service Loki stream (G2) ---
  # docker json-file lines are {"log","stream","time"}; json_parser pulls the
  # message out, then we set service.name on the RESOURCE directly from the
  # container ID in the log file path (the id→name map is gathered live at apply
  # time — see the docker-ps task). Done in stanza, NOT the k8s-oriented
  # `container` operator (which errors "failed to detect a valid log path" on
  # docker paths in 0.120). Each ai-* container gets its own stream; unknown
  # ids fall back to gpu-stack.
  filelog/containers:
    include:
      - /var/lib/docker/containers/*/*-json.log
    start_at: end
    include_file_path: true
    operators:
      - type: json_parser
        parse_from: body
      - type: move
        from: attributes.log
        to: body
        if: "attributes.log != nil"
{% for _line in (triage_docker_ps.stdout_lines | default([])) %}
{% set _p = _line.split() %}
{% if _p | length >= 2 %}
      - type: add
        field: resource["service.name"]
        value: "{{ _p[1] }}"
        if: 'attributes["log.file.path"] matches "{{ _p[0] }}"'
{% endif %}
{% endfor %}
      - type: add
        field: resource["service.name"]
        value: "gpu-stack"
        if: 'resource["service.name"] == nil'

  # --- Ollama host unit logs (G5) ---
  # Ollama is a HOST systemd unit, so its logs go to journald — which this image
  # can't read (no journalctl; the journald receiver crash-looped). Instead a
  # systemd drop-in mirrors the unit's stdout/stderr to a plain file (see the
  # role's ollama drop-in task) and we tail that as service_name=ollama.
  filelog/ollama:
    include:
      - /var/log/ollama/ollama.log
    start_at: end

processors:
  # Common attributes for everything off this host.
  resource/common:
    attributes:
      - action: insert
        key: host.name
        value: {{ triage_otel_host_name }}
      - action: insert
        key: deployment.environment
        value: cires

  # (G2 service.name is now set directly in the filelog stanza operators above —
  # the OTTL/groupbyattrs resource-context approach didn't fire because filelog's
  # log.file.path isn't where a resource-context match could see it.)

  # G5: tag the Ollama log-file stream.
  resource/ollama:
    attributes:
      - action: upsert
        key: service.name
        value: ollama

  batch:
    send_batch_size: 200
    send_batch_max_size: 200
    timeout: 5s

exporters:
  otlphttp/loki:
    endpoint: "http://{{ triage_monitoring_host }}:{{ loki_port | default(3100) }}/otlp"
    tls:
      insecure: true

extensions:
  health_check:
    endpoint: "0.0.0.0:13133"

service:
  extensions: [health_check]
  telemetry:
    logs:
      level: warn
  pipelines:
    # Container logs -> per-service stream (G2).
    logs/containers:
      receivers: [filelog/containers]
      processors: [resource/common, batch]
      exporters: [otlphttp/loki]
    # Ollama host-unit log file -> service_name=ollama (G5).
    logs/ollama:
      receivers: [filelog/ollama]
      processors: [resource/common, resource/ollama, batch]
      exporters: [otlphttp/loki]
