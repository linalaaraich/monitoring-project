# =============================================================================
# CIRES AI triage .env — GPU host (NEW ACCOUNT). MANAGED BY ANSIBLE.
# Templated by roles/triage_stack/templates/env.j2 to {{ triage_stack_dir }}/.env
# on every playbook run. DO NOT EDIT BY HAND — overwritten on the next run.
#
# Secrets (SMTP_PASSWORD) are NOT stored in the repo. They are resolved at
# playbook run time from the controller's environment — set before running:
#     export GRAFANA_SMTP_PASSWORD="<gmail-app-password>"
#     ansible-playbook -i inventory/newacct.yml playbooks/gpu.yml
# Mirrors the same lookup('env', ...) pattern used by group_vars/ai.yml and
# the triage_laptop role. The rendered .env on the host is mode 0600 and is
# gitignored (.env / .env.*), so it never lands in version control.
#
# NOTE (NEW-3): no "Last templated:" timestamp here — a volatile
# ansible_date_time.iso8601 line baked into managed content defeats Ansible's
# content-based change detection, making .env perpetually "changed" and firing
# the restart handler on every run. Git history records when it was templated.
# =============================================================================

# Image tags (auto-pulled at boot from GHCR)
TRIAGE_TAG={{ triage_image_tag }}
IMAGE_TAG={{ mcp_image_tag }}

# Ollama model loaded on the host GPU. 14b primary on the A10G; 7b fallback.
OLLAMA_MODEL={{ triage_ollama_model }}

# =============================================================================
# Triage service tunables (override defaults in app/config.py)
# =============================================================================

# Grafana — via Tailscale MagicDNS to the new monitoring host
GRAFANA_URL=http://{{ triage_monitoring_host }}:{{ grafana_port | default(3000) }}
GRAFANA_API_USER={{ triage_grafana_api_user }}
GRAFANA_API_PASSWORD={{ triage_grafana_api_password }}

# Context gathering bundle size
PROMETHEUS_RANGE_MINUTES={{ triage_prometheus_range_minutes }}
LOKI_LOG_LIMIT={{ triage_loki_log_limit }}
JAEGER_TRACE_LIMIT={{ triage_jaeger_trace_limit }}
CONTEXT_TIMEOUT={{ triage_context_timeout }}

# Dedup + Layer-2 suppression
DEDUP_WINDOW_SECONDS={{ triage_dedup_window_seconds }}
TRIAGE_SUPPRESSION_ENABLED={{ triage_suppression_enabled | string | lower }}
TRIAGE_HISTORY_LOOKBACK_MINUTES={{ triage_history_lookback_minutes }}

# Data-starved retry + bounded agency
TRIAGE_DATA_STARVED_RETRY_ENABLED={{ triage_data_starved_retry_enabled | string | lower }}
TRIAGE_BOUNDED_AGENCY_ENABLED={{ triage_bounded_agency_enabled | string | lower }}

# Drain3 self-alerting
DRAIN3_ALERT_ENABLED={{ triage_drain3_alert_enabled | string | lower }}
DRAIN3_ALERT_RATE_THRESHOLD={{ triage_drain3_alert_rate_threshold }}
DRAIN3_ALERT_MIN_LINES={{ triage_drain3_alert_min_lines }}
DRAIN3_ALERT_COOLDOWN_SECONDS={{ triage_drain3_alert_cooldown_seconds }}

# Ollama resilience
OLLAMA_REQUEST_TIMEOUT={{ triage_ollama_request_timeout }}
PIPELINE_TIMEOUT={{ triage_pipeline_timeout }}
CIRCUIT_BREAKER_FAILURE_THRESHOLD={{ triage_circuit_breaker_failure_threshold }}
CIRCUIT_BREAKER_COOLDOWN_SECONDS={{ triage_circuit_breaker_cooldown_seconds }}

# Startup backfill
STARTUP_BACKFILL_THRESHOLD_MINUTES={{ triage_startup_backfill_threshold_minutes }}
STARTUP_BACKFILL_MAX_GAP_HOURS={{ triage_startup_backfill_max_gap_hours }}

# =============================================================================
# SMTP — for escalation emails. Password resolved from the controller env
# (GRAFANA_SMTP_PASSWORD); never committed to the repo.
# =============================================================================
SMTP_HOST={{ triage_smtp_host }}
SMTP_PORT={{ triage_smtp_port }}
SMTP_USER={{ triage_smtp_user }}
SMTP_PASSWORD={{ triage_smtp_password }}
SMTP_FROM={{ triage_smtp_from }}
NOTIFICATION_EMAIL={{ triage_notification_email }}
