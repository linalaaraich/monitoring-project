          summary: "Medium memory usage"
          description: "Memory usage is above 80% for 1 minute."
          # US-5.8 recurrence-gate opt-in (warning-severity, see D21).
          recurrence_gate: "pre_llm=4,llm_dismiss=2,window=2h"

      - uid: target-down
        title: TargetDown
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: 'up == 0'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 300
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
        noDataState: OK
        execErrState: Error
        for: 2m
        labels:
          severity: critical
          service: monitoring
          signal: metric
          component: scrape
          timeframe: 5m
        annotations:
          expr: 'up == 0'
          summary: "Monitored target is down"
          description: "A Prometheus scrape target has been unreachable for 2 minutes."

      - uid: disk-filling-up
        title: DiskFillingUp
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: 'predict_linear(node_filesystem_avail_bytes{mountpoint="/",fstype!=""}[6h], 24*3600)'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 21600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [0]
        noDataState: OK
        execErrState: Error
        for: 30m
        labels:
          severity: warning
          service: k3s-node
          signal: metric
          component: infrastructure
          timeframe: 6h
        annotations:
          expr: 'predict_linear(node_filesystem_avail_bytes{mountpoint="/",fstype!=""}[6h], 24*3600)'
          summary: "Disk predicted to fill within 24h"
          description: "Based on the last 6 hours of data, the root filesystem is predicted to run out of space within 24 hours."

  - orgId: 1
    name: kubernetes_alerts
    folder: Provisioned Alerts
    interval: 60s
    rules:
      # Generic workload-down — fires for ANY deployment with unavailable
      # replica(s), so liveness coverage is AUTOMATIC for every service
      # (current and future) with zero per-service rules to maintain. Driven
      # by kube-state-metrics; routes to triage via the default notification
      # policy. NOTE: KSM is scraped via pod annotations, so Prometheus
      # clobbers the metric's own `namespace` with the KSM pod's ns — the REAL
      # namespace is `exported_namespace`. noDataState: Alerting makes it a
      # watchdog (if KSM itself disappears, alert rather than go silent).
      # (2026-06-04 — audit P0.1/A-2; the no-alert-on-app-down outage.)
      - uid: kube-workload-down
        title: KubeWorkloadDown
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: 'max by (namespace, service) (label_replace(label_replace(kube_deployment_status_replicas_unavailable{exported_namespace!="kube-system"}, "namespace", "$1", "exported_namespace", "(.+)"), "service", "$1", "deployment", "(.+)"))'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [0]
        noDataState: Alerting
        execErrState: Error
        for: 3m
        # service + namespace are minted as REAL labels by the label_replace in
        # the query above (Grafana carries query-result labels onto the alert),
        # so the down workload is named in the alert and the triage pipeline gets
        # a real affected_service (was "unknown"). NOTE: Grafana does NOT template
        # the `labels:` block — only annotations — so these must come from the
        # query (label_replace), not from label templating in this block.
        labels:
          severity: critical
          signal: availability
          component: k8s
          timeframe: 10m
        annotations:
          summary: 'Workload {{ "{{" }} $labels.namespace {{ "}}" }}/{{ "{{" }} $labels.service {{ "}}" }} has unavailable replica(s)'
          description: 'Deployment {{ "{{" }} $labels.service {{ "}}" }} in namespace {{ "{{" }} $labels.namespace {{ "}}" }} has had unavailable replica(s) for 3m (kube_deployment_status_replicas_unavailable > 0). Generic across all services via kube-state-metrics. Check: kubectl -n {{ "{{" }} $labels.namespace {{ "}}" }} get deploy {{ "{{" }} $labels.service {{ "}}" }} and pod events.'

      # COMPANION to KubeWorkloadDown (2026-06-04 — audit OBS-D2). The rule above
      # keys on kube_deployment_status_replicas_unavailable, which is only a
      # meaningful (>0) value while a deployment EXISTS and has pods it expects
      # to be up. It is BLIND to two cases:
      #   1) A deployment scaled to 0 replicas that SHOULD be running N>0
      #      (status_replicas_unavailable is 0/absent — nothing is "unavailable",
      #      there's simply nothing scheduled), and
      #   2) A deployment object DELETED entirely (the unavailable series stops
      #      existing, so the rule above has no series to threshold and goes
      #      silent rather than alerting).
      #
      # This rule catches both by comparing the DESIRED spec replicas against the
      # AVAILABLE replicas: kube_deployment_spec_replicas - status_replicas_available.
      # When spec=N and available<N (including available=0 / scaled-to-0-but-spec>0
      # / all-pods-crashlooping) the difference is >= 1 and we fire. Because it is
      # driven off spec_replicas (which DOES carry a value at 0-available) it
      # covers the scaled-to-0 gap; the threshold of >=1 means a deliberately
      # scaled-to-0 deployment (spec=0) yields 0 and does NOT fire, so it stays
      # complementary to the rule above (no trivial double-fire: that rule keys on
      # `unavailable`, this one on the spec-vs-available DEFICIT).
      #
      # Same KSM label-clobber gotcha applies: Prometheus overwrites the metric's
      # own `namespace` with the KSM pod's ns, so the REAL namespace is in
      # `exported_namespace`. We mirror the existing rule's double label_replace
      # (exported_namespace -> namespace, deployment -> service) so the alert
      # payload carries a real affected_service, not a literal {{ "{{" }} $labels.deployment {{ "}}" }}.
      # noDataState: Alerting keeps it a watchdog if KSM itself disappears.
      - uid: kube-workload-replicas-deficit
        title: KubeWorkloadReplicasDeficit
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: 'max by (namespace, service) (label_replace(label_replace((kube_deployment_spec_replicas{exported_namespace!="kube-system"} - kube_deployment_status_replicas_available{exported_namespace!="kube-system"}), "namespace", "$1", "exported_namespace", "(.+)"), "service", "$1", "deployment", "(.+)"))'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [0]
        noDataState: Alerting
        execErrState: Error
        for: 3m
        # service + namespace are minted as REAL labels by the label_replace in
        # the query (same pattern as KubeWorkloadDown) so the down workload is
        # named in the alert payload. Grafana does NOT template the `labels:`
        # block — only annotations — so these must come from the query.
        labels:
          severity: critical
          signal: availability
          component: k8s
          timeframe: 10m
        annotations:
          summary: 'Workload {{ "{{" }} $labels.namespace {{ "}}" }}/{{ "{{" }} $labels.service {{ "}}" }} has fewer available than desired replicas'
          description: 'Deployment {{ "{{" }} $labels.service {{ "}}" }} in namespace {{ "{{" }} $labels.namespace {{ "}}" }} has had a desired-vs-available replica deficit for 3m (kube_deployment_spec_replicas - kube_deployment_status_replicas_available >= 1). Catches the cases KubeWorkloadDown misses: scaled-to-0-but-should-run, all-replicas-down, or available=0. Check: kubectl -n {{ "{{" }} $labels.namespace {{ "}}" }} get deploy {{ "{{" }} $labels.service {{ "}}" }} and pod events.'

      # Pod-level memory pressure (added 2026-04-28 PM after chaos run 3
      # found 0/4 captures — the host-level HighMemoryUsage rule above
      # measures node_memory_*, not the per-pod cgroup, so pod-scoped
      # chaos like `kubectl set resources --limits memory=256Mi` never
      # moves the host metric. This rule measures the working set against
      # the pod's own cgroup limit, which is what an operator actually
      # cares about for "is my service's container approaching OOM".
      - uid: pod-high-memory-usage
        title: PodHighMemoryUsage
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: |
                (
                  container_memory_working_set_bytes{namespace=~"app|rental",container=~"spring-boot|backend"}
                  /
                  container_spec_memory_limit_bytes{namespace=~"app|rental",container=~"spring-boot|backend"}
                ) * 100
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [85]
        noDataState: OK
        execErrState: Error
        for: 2m
        labels:
          severity: warning
          service: employees-backend
          signal: metric
          component: pod
          timeframe: 10m
        annotations:
          expr: '(container_memory_working_set_bytes{namespace=~"app|rental",container=~"spring-boot|backend"} / container_spec_memory_limit_bytes{namespace=~"app|rental",container=~"spring-boot|backend"}) * 100'
          summary: "employees-backend pod memory above 85% of cgroup limit"
          description: "employees-backend pod working-set memory has been above 85% of its cgroup limit for 2m. Risk of imminent OOMKill. Check JVM heap (Micrometer jvm_memory_used_bytes) and pod resource requests/limits. (Container name remains `spring-boot` because the image's entry point expects it; the operator-facing app token is `employees-backend`.)"

      # Pod-level CPU pressure. Same rationale as PodHighMemoryUsage:
      # the host-level HighCpuUsage rule averages across the whole node,
      # so pod-scoped chaos can saturate one container's cgroup without
      # moving the node average. This rule measures pod CPU usage as a
      # fraction of its CPU quota.
      - uid: pod-high-cpu-usage
        title: PodHighCpuUsage
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: |
                (
                  rate(container_cpu_usage_seconds_total{namespace=~"app|rental",container=~"spring-boot|backend"}[5m])
                  /
                  (container_spec_cpu_quota{namespace=~"app|rental",container=~"spring-boot|backend"} / container_spec_cpu_period{namespace=~"app|rental",container=~"spring-boot|backend"})
                ) * 100
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [80]
        noDataState: OK
        execErrState: Error
        for: 2m
        labels:
          severity: warning
          service: employees-backend
          signal: metric
          component: pod
          timeframe: 10m
        annotations:
          expr: '(rate(container_cpu_usage_seconds_total{namespace=~"app|rental",container=~"spring-boot|backend"}[5m]) / (container_spec_cpu_quota{namespace=~"app|rental",container=~"spring-boot|backend"} / container_spec_cpu_period{namespace=~"app|rental",container=~"spring-boot|backend"})) * 100'
          summary: "employees-backend pod CPU above 80% of cgroup quota"
          description: "employees-backend pod CPU usage has been above 80% of its cgroup CPU quota for 2m. Likely throttling on the cgroup. Investigate hot endpoints (HTTP request rate per URI), JVM threads, GC pressure. (Container name remains `spring-boot`; operator-facing app token is `employees-backend`.)"

  - orgId: 1
    name: log_alerts
    folder: Provisioned Alerts
    interval: 60s
    rules:
      - uid: loki-high-disk-usage
        title: LokiHighDiskUsage
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: '(1 - node_filesystem_avail_bytes{mountpoint="/",fstype!="",{{ mon_node_selector }}} / node_filesystem_size_bytes{mountpoint="/",fstype!="",{{ mon_node_selector }}}) * 100'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [85]
        noDataState: OK
        execErrState: Error
        for: 5m
        labels:
          severity: warning
          service: loki
          signal: metric
          component: observability
          timeframe: 10m
        annotations:
          expr: '(1 - node_filesystem_avail_bytes{mountpoint="/",fstype!="",{{ mon_node_selector }}} / node_filesystem_size_bytes{mountpoint="/",fstype!="",{{ mon_node_selector }}}) * 100'
          summary: "High disk usage on monitoring VM (Loki storage)"
          description: "Root filesystem on monitoring VM is at high usage."

      - uid: loki-critical-disk-usage
        title: LokiCriticalDiskUsage
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: '(1 - node_filesystem_avail_bytes{mountpoint="/",fstype!="",{{ mon_node_selector }}} / node_filesystem_size_bytes{mountpoint="/",fstype!="",{{ mon_node_selector }}}) * 100'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [95]
        noDataState: OK
        execErrState: Error
        for: 2m
        labels:
          severity: critical
          service: loki
          signal: metric
          component: observability
          timeframe: 10m
        annotations:
          expr: '(1 - node_filesystem_avail_bytes{mountpoint="/",fstype!="",{{ mon_node_selector }}} / node_filesystem_size_bytes{mountpoint="/",fstype!="",{{ mon_node_selector }}}) * 100'
          summary: "Critical disk usage on monitoring VM (Loki storage)"
          description: "Root filesystem on monitoring VM is at critical usage. Immediate action required."

      - uid: loki-ingestion-rate-low
        title: LokiIngestionRateLow
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: 'sum(rate(loki_distributor_bytes_received_total[5m]))'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 900
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [1024]
        noDataState: OK
        execErrState: Error
        for: 10m
        labels:
          severity: warning
          service: loki
          signal: log
          component: observability
          timeframe: 15m
        annotations:
          expr: 'rate(loki_distributor_bytes_received_total[5m])'
          summary: "Log ingestion rate low"
          description: "Loki log ingestion rate has been below 1 KB/sec for 10 minutes. Check OTel Collector log pipelines."

      - uid: loki-disk-filling-up
        title: LokiDiskFillingUp
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: 'predict_linear(node_filesystem_avail_bytes{mountpoint="/",fstype!="",{{ mon_node_selector }}}[6h], 24*3600)'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 21600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [0]
        noDataState: OK
        execErrState: Error
        for: 30m
        labels:
          severity: warning
          service: loki
          signal: metric
          component: observability
          timeframe: 6h
        annotations:
          expr: 'predict_linear(node_filesystem_avail_bytes{mountpoint="/",fstype!="",{{ mon_node_selector }}}[6h], 24*3600)'
          summary: "Loki storage disk predicted to fill within 24h"
          description: "Based on the last 6 hours of data, the monitoring VM root filesystem is predicted to run out of space within 24 hours."
