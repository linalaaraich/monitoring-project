                    params: [95]
        noDataState: OK
        execErrState: Error
        for: 2m
        labels:
          severity: critical
          service: k3s-node
          signal: metric
          component: infrastructure
          timeframe: 10m
        annotations:
          expr: '100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100)'
          summary: "Critical CPU usage"
          description: "CPU usage has been above 95% for 2 minutes."

      - uid: high-memory-usage
        title: HighMemoryUsage
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: '(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [85]
