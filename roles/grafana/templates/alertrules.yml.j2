apiVersion: 1

{# K8s migration: When k3s_sd_enabled is true, use pod-based selectors instead of VM job labels. #}
{# #}
{# Spring Boot selector (k3s): the Prometheus kubernetes_sd scrape attaches `container` but NOT `app` #}
{# as a label (kong-kong is the only pod with `app=...`). So `app="spring-boot"` matched nothing in #}
{# practice. The `container="spring-boot"` label is stable across restarts/re-deploys. We also exclude #}
{# /actuator URIs because the app scraping itself inflates request counts with sub-ms spans that pull #}
{# the p95 down and mask real user-facing latency. #}
{# #}
{# OTel selector (k3s): same reason — pods don't get `app=`. `container="otel-collector"` targets the #}
{# in-cluster collector (the one Spring Boot actually exports to). The VM-mode `job="otel-collector"` #}
{# label still exists for the monitoring-VM-local collector, but that one is covered by TargetDown. #}
{% if k3s_sd_enabled | default(false) %}
{% set spring_selector = 'container="spring-boot",uri!~"/actuator.*"' %}
{% set otel_selector = 'container="otel-collector"' %}
{% else %}
{% set spring_selector = 'job="app-spring-actuator"' %}
{% set otel_selector = 'job="otel-collector"' %}
{% endif %}
{% set mon_node_selector = 'job="mon-node-exporter"' %}

groups:
  - orgId: 1
    name: tracing_alerts
    folder: Provisioned Alerts
    interval: 60s
    rules:
      # STATIC THRESHOLD — temporary regression from adaptive (2026-06-02).
      # TODO 2026-06-09: revert to adaptive once new account has 7d baseline.
      # Same `or vector(N)` label-loss bug as MediumCpuUsage — see comment
      # on that rule. Using the historical fallback floor (1000ms) directly.
      - uid: high-p95-latency
        title: HighP95Latency
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: 'histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{{ "{" }}{{ spring_selector }}{{ "}" }}[5m])) by (le)) * 1000'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [1000]
        noDataState: OK
        execErrState: Error
        for: 2m
        labels:
          severity: warning
          service: employees-backend
          signal: metric
          component: api
          timeframe: 10m
          # adaptive_threshold removed 2026-06-02 — see TODO above.
        annotations:
          expr: 'histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{{ "{" }}{{ spring_selector }}{{ "}" }}[5m])) by (le)) * 1000'
          summary: "P95 request latency above 1000ms"
          description: "employees-backend p95 latency has exceeded 1000ms for 2m. Static threshold (temporary, until 7d baseline accumulates on the new account)."
          # P2 fix (2026-05-19) — recurrence-gate opt-in.
          # Warning-severity (severity: warning above) and historically
          # prone to dismiss-cascades during traffic-driven spikes. The
          # post-LLM gate force-escalates after 2 dismisses in a 2h
          # window so a cascade can't silence a sustained real latency
          # regression. See decisions-log D21.
          recurrence_gate: "pre_llm=4,llm_dismiss=2,window=2h"

      # STATIC THRESHOLD — temporary regression from adaptive (2026-06-02).
      # TODO 2026-06-09: revert to adaptive once new account has 7d baseline.
      # Same `or vector(N)` label-loss bug as MediumCpuUsage — see comment
      # on that rule. Using the historical fallback floor (1000ms) directly.
      - uid: high-kong-p95-latency
        title: HighKongP95Latency
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: 'histogram_quantile(0.95, sum(rate(kong_request_latency_ms_bucket[5m])) by (le))'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [1000]
        noDataState: OK
        execErrState: Error
        for: 2m
        labels:
          severity: warning
          service: kong
          signal: metric
          component: gateway
          timeframe: 10m
          # adaptive_threshold removed 2026-06-02 — see TODO above.
        annotations:
          expr: 'histogram_quantile(0.95, sum(rate(kong_request_latency_ms_bucket[5m])) by (le))'
          summary: "P95 Kong latency above 1000ms"
          description: "Kong p95 end-to-end latency has exceeded 1000ms for 2m. Static threshold (temporary, until 7d baseline accumulates on the new account)."
          # P2 fix (2026-05-19) — recurrence-gate opt-in.
          # Warning-severity (severity: warning above). Force-escalates
          # after 2 LLM dismisses in a 2h window so a cascade of
          # "looks like a spike" dismisses can't silence a sustained
          # gateway-layer latency regression. See decisions-log D21.
          recurrence_gate: "pre_llm=4,llm_dismiss=2,window=2h"

      - uid: otel-collector-high-span-drop-rate
        title: OTelCollectorHighSpanDropRate
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: '((sum(rate(otelcol_exporter_send_failed_spans[5m])) + sum(rate(otelcol_receiver_refused_spans[5m]))) / clamp_min(sum(rate(otelcol_receiver_accepted_spans[5m])), 1))'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 600
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [0.05]
        noDataState: OK
        execErrState: Error
        for: 2m
        labels:
          severity: critical
          service: otel-collector
          signal: metric
          component: observability
          timeframe: 10m
        annotations:
          expr: '(sum(rate(otelcol_processor_dropped_spans_total[5m])) / clamp_min(sum(rate(otelcol_receiver_accepted_spans_total[5m])), 1))'
          summary: "OTel Collector dropping >5% of spans"
          description: "The OTel Collector is dropping more than 5% of received spans."

      - uid: otel-collector-down
        title: OTelCollectorDown
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: 'up{{ "{" }}{{ otel_selector }}{{ "}" }}'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 300
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
        noDataState: OK
        execErrState: Error
        for: 1m
        labels:
          severity: critical
          service: otel-collector
          signal: metric
          component: observability
          timeframe: 5m
        annotations:
          expr: 'up{{ "{" }}{{ otel_selector }}{{ "}" }}'
          summary: "OTel Collector is down"
          description: "The OTel Collector instance has been unreachable for 1 minute."

  - orgId: 1
