              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [85]
        noDataState: OK
        execErrState: Error
        for: 5m
        labels:
          severity: warning
          service: k3s-node
          signal: metric
          component: infrastructure
          timeframe: 10m
        annotations:
          expr: '100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100)'
          summary: "High CPU usage"
          description: "CPU usage has been above 85% for 5 minutes."

      - uid: critical-cpu-usage
        title: CriticalCpuUsage
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: '100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100)'
              instant: false
