          timeframe: 10m
        annotations:
          expr: '(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100'
          summary: "Critical memory usage"
          description: "Memory usage has exceeded 95%. OOM risk."

      # STATIC THRESHOLD — temporary regression from adaptive (2026-06-02).
      # TODO 2026-06-09: revert to adaptive once new account has 7d baseline.
      #
      # Original rule used `or vector(80)` as a static-fallback when no 7d
      # baseline existed, but `vector(80)` is a 1-element vector with NO
      # `instance` label, so the outer subtraction (which IS labelled by
      # instance from the rate() avg by(instance)) had no label match and
      # produced an empty vector even at 100% CPU. Result: rule was
      # permanently `inactive`. See real-induction agent finding 2026-06-02.
      #
      # Quickest fix: drop the adaptive baseline expression entirely for
      # the bring-up week and use the static fallback floor (80%) directly.
      # Adaptive returns on 2026-06-09 when there's 7d of history on the
      # new account; that diff will revert this block.
      - uid: medium-cpu-usage
        title: MediumCpuUsage
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            model:
              expr: '100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[1m])) * 100)'
              instant: false
              range: true
              intervalMs: 15000
            relativeTimeRange:
              from: 300
              to: 0
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [80]
        noDataState: OK
        execErrState: Error
        for: 1m
        labels:
          severity: warning
          service: k3s-node
          signal: metric
          component: infrastructure
          timeframe: 5m
          # adaptive_threshold removed 2026-06-02 — see TODO above.
        annotations:
          expr: '100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[1m])) * 100)'
          summary: "CPU usage above 80%"
          description: "Per-instance CPU has exceeded 80% for 1 minute. Static threshold (temporary, until 7d baseline accumulates on the new account)."
          # US-5.8 recurrence-gate opt-in. Warning-severity rule with a known
          # noise profile — first 4 fires inside 2h are gated pre-LLM (no
          # email), and if the LLM dismisses the same fingerprint twice in
          # the window the next dismiss is force-flipped to ESCALATE so a
          # human can decide whether the rule is too noisy or there's a
          # real signal the LLM missed. CRITICAL-severity rules MUST NOT
          # carry this annotation. See decisions-log D21.
          # Tuned 2026-06-01 after audit: llm_dismiss was 2 — created a noise
          # loop where 71 of 76 MediumCpuUsage emails on k3s-node were
          # force-escalates of LLM dismissals. Raised to 10 so the gate's
          # "human catches what the LLM misses" backstop still fires for
          # genuinely-sustained noise, but normal periodic CPU bursts
          # don't generate a recurring email storm.
          recurrence_gate: "pre_llm=4,llm_dismiss=10,window=2h"

      - uid: medium-memory-usage
